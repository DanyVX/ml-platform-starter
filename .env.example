# Environment: development, test, production
MLP_ENVIRONMENT=development
# Logging: DEBUG, INFO, WARNING, ERROR. Use JSON in deployed services.
MLP_LOG_LEVEL=INFO
MLP_LOG_JSON=false
# Fixed seed for deterministic synthetic data and split generation (M1).
MLP_RANDOM_SEED=42
# Tiny CPU-only smoke mode. This is NOT a real-world benchmark.
MLP_TINY_ROWS=200
# Holdout fractions; their sum must be less than 0.5.
MLP_VALIDATION_FRACTION=0.2
MLP_TEST_FRACTION=0.2
# No credentials are needed in M0. Future secrets must be set locally, never committed.

# MLflow server URL or SQLite URI; SQLite is local only. No secrets here.
MLP_TRACKING_URI=sqlite:///mlflow.db

# Only trusted registry model artifacts. Do not expose publicly without auth/TLS.
MLP_CACHE_DIR=artifacts/model-cache
MLP_RELOAD_INTERVAL=30
MLP_PREDICTION_TIMEOUT=5

# Only local demo percentages; automatic rollback uses bounded canary evaluation.
MLP_CANARY_PERCENT=0
MLP_SHADOW_MODE=false
# Set to a known-good model version to manually revert the champion alias.
MLP_ROLLBACK_VERSION=
# Set a real strong local password (never commit private secret).
GRAFANA_ADMIN_PASSWORD=
