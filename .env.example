# Environment: development, test, production
MLP_ENVIRONMENT=development
# Logging: DEBUG, INFO, WARNING, ERROR. Use JSON in deployed services.
MLP_LOG_LEVEL=INFO
MLP_LOG_JSON=false
# Fixed seed for deterministic synthetic data and split generation (M1).
MLP_RANDOM_SEED=42
# Tiny CPU-only smoke mode. This is NOT a real-world benchmark.
MLP_TINY_ROWS=200
# Holdout fractions; their sum must be less than 0.5.
MLP_VALIDATION_FRACTION=0.2
MLP_TEST_FRACTION=0.2
# No credentials are needed in M0. Future secrets must be set locally, never committed.
